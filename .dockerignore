# Artefactos y dependencias: se regeneran en el build.
node_modules
.next
out
build
coverage
# Cliente de Prisma generado: el builder lo regenera para su plataforma.
src/generated

# Secretos y entorno local: nunca entran en la imagen.
.env
.env.*
!.env.example

# Control de versiones y metadatos.
.git
.github
.gitignore

# Documentación y planificación: no forman parte del runtime. Excepción:
# docs/legal, que la página /legal/terminos lee del disco al prerenderizarse.
docs/*
!docs/legal
plans
infra
README*.md
AGENTS.md
CLAUDE.md

# Configuración de editor/herramientas de desarrollo.
.vscode
.idea
.editorconfig
.prettierrc
.prettierignore
.claude

# Tests: no se ejecutan dentro de la imagen de producción.
tests
**/*.test.ts
vitest.config.ts
