// Modelos de plataforma que consume el back-office. Aquí solo se DECLARAN; las
// pantallas de administración los leen/escriben en fases posteriores sin tocar
// este schema. AuditLog y UsageEvent son append-only (lo refuerza un trigger SQL
// en la migración, además de no exponer update/delete en los repos).

// Traza de acciones administrativas. Append-only: fuente fiable, no falsificable.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

// Mapeo acción→modelo de IA, editable en runtime sin redeploy. `provider`/
// `baseURL` permiten el fallback de gateway (valor de allowlist, no arbitrario).
// NO almacena API keys: solo nombres de modelo y flags.
model ModelConfig {
  id           String      @id @default(cuid())
  action       ModelAction @unique
  primaryModel String
  fallbacks    String[]
  provider     String?
  baseURL      String?
  enabled      Boolean     @default(true)
  updatedAt    DateTime    @updatedAt

  @@map("model_config")
}

// Cadena ordenada de proveedores/modelos para cada uso de IA. A diferencia de
// `ModelConfig.fallbacks`, cada respaldo conoce el proveedor que lo ejecuta,
// permitiendo conmutar entre KIE, NaN y OpenRouter de forma real.
model AiModelRoute {
  id        String      @id @default(cuid())
  action    ModelAction
  position  Int
  provider  String
  model     String
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([action, position])
  @@index([action, enabled])
  @@map("ai_model_route")
}

// Perfiles reutilizables de mapeo IA. Los perfiles de sistema viven en código;
// esta tabla guarda las variantes personalizadas creadas desde administración.
model AiModelProfile {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  configurations Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ai_model_profile")
}

// Credenciales de proveedores de IA administradas en runtime. La clave se guarda
// cifrada; el panel sólo recibe su huella y nunca puede volver a leerla.
model AiProviderCredential {
  provider        String   @id
  encryptedApiKey String
  keyHint         String
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("ai_provider_credential")
}

// Proveedor de IA compatible con OpenAI añadido desde el panel (APIMart, NodeClub.ai…). Su clave vive en
// AiProviderCredential con el mismo id y solo se envía a esta URL; cambiarla exige una clave nueva.
model AiCustomProvider {
  id        String          @id
  label     String
  baseUrl   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("ai_custom_provider")
}

// Modelo de texto o visión que habilita el administrador, de un proveedor propio o de OpenRouter, NaN u OpenAI
// (`providerId` es el id del proveedor, sin clave foránea: los integrados no tienen fila en ai_custom_provider). Se
// habilita para unos usos y con su precio de entrada por 1M tokens, que cuenta para el techo de cada uso y para
// estimar el coste cuando el proveedor no lo informa.
model AiCustomModel {
  id              String           @id @default(cuid())
  providerId      String
  model           String
  label           String
  actions         ModelAction[]
  priceUsdPerUnit Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([providerId, model])
  @@map("ai_custom_model")
}

// Configuración de marca (singleton). El logo referencia un MediaAsset.
model BrandSettings {
  id                String   @id @default(cuid())
  brandName         String
  logoAssetId       String?
  logoMobileAssetId String?
  colors            Json?
  updatedAt         DateTime @updatedAt

  @@map("brand_settings")
}

// Feature flags y límites/cuotas configurables (welcome_credits, caps, etc.).
model SystemSetting {
  id      String  @id @default(cuid())
  key     String  @unique
  value   Json
  enabled Boolean @default(true)

  @@map("system_setting")
}

// Carpeta del gestor de media (jerarquía auto-referenciada).
model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("MediaFolderTree")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())

  @@index([parentId])
  @@map("media_folder")
}

model MediaAsset {
  id        String       @id @default(cuid())
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  key       String
  url       String
  mime      String
  size      Int
  width     Int?
  height    Int?
  status    MediaStatus  @default(PENDING)
  createdBy String
  createdAt DateTime     @default(now())

  @@index([folderId])
  @@map("media_asset")
}

// Telemetría de consumo de IA (append-only), separada del ledger contable.
model UsageEvent {
  id        String    @id @default(cuid())
  userId    String?
  orgId     String?
  action    String
  unit      UsageUnit
  amount    Int
  cost      Decimal   @db.Decimal(12, 6)
  refId     String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@map("usage_event")
}

// Coste operativo de cada intento contra un proveedor de IA. No forma parte del
// ledger de créditos: conserva por separado importes confirmados, estimados y
// desconocidos. requestId + attempt hace la escritura reintentable/idempotente.
model AiRequestCost {
  id             String      @id @default(cuid())
  requestId      String
  attempt        Int
  organizationId String
  userId         String?
  projectId      String?
  refId          String?
  batchId        String?
  action         ModelAction
  operation      String
  provider       String
  model          String
  status         String
  latencyMs      Int
  units          Json?
  costUsd        Decimal?    @db.Decimal(14, 8)
  costType       String
  errorCode      String?
  createdAt      DateTime    @default(now())

  @@unique([requestId, attempt])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([provider, model, status])
  @@index([projectId, createdAt])
  @@index([refId, createdAt])
  @@map("ai_request_cost")
}

// Evaluaciones de calidad de Jev por punto de control. Aditiva y sin FKs: es
// telemetría de decisión (también guarda los fallos en los que no se pudo
// evaluar) y su coste lo absorbe la plataforma, no los créditos del usuario.
model AiQualityEvaluation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  projectId      String?
  checkpoint     String
  refId          String?
  score          Int?
  decision       String
  confidence     Float?
  answers        Json
  reasons        Json
  evidenceHash   String
  jevModel       String?
  inputTokens    Int?
  costUsd        Decimal  @db.Decimal(14, 8)
  failOpen       Boolean
  errorCode      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([checkpoint, createdAt])
  @@index([refId])
  @@index([organizationId, checkpoint, evidenceHash])
  @@map("ai_quality_evaluation")
}
