// Biblioteca personal compartida por todos los proyectos del titular.
model ElementPackage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  document  Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("element_package")
}
