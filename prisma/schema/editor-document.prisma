// Absence means legacy authority. Presence means v2, even when writes are paused.
model EditorDocumentState {
  id             String @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           ProjectZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  headRevision   Int @default(0)
  writable       Boolean @default(true)
  legacySnapshot Json
  legacyFingerprint String
  createdAt      DateTime @default(now())
  revisions      EditorDocumentRevision[]
  approvals      EditorDesignApproval[]

  // Partial unique indexes protect default (zoneId NULL) and named zones.
  @@index([projectId])
  @@index([zoneId])
  @@map("editor_document_state")
}

model EditorDocumentRevision {
  id          String @id @default(cuid())
  stateId     String
  state       EditorDocumentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  revision    Int
  document    Json
  requestKey  String?
  fingerprint String
  createdAt   DateTime @default(now())
  approval    EditorDesignApproval?

  @@unique([stateId, revision])
  @@unique([stateId, requestKey])
  @@map("editor_document_revision")
}

// Aprobación separada: la revisión del editor tiene un trigger que prohíbe actualizarla.
model EditorDesignApproval {
  id          String @id @default(cuid())
  stateId     String
  state       EditorDocumentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  revisionId  String @unique
  revision    EditorDocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fingerprint String
  assets      Json
  approvedById String
  lightingPreset String @default("daylight")
  approvedAt  DateTime @default(now())

  @@index([stateId, approvedAt])
  @@map("editor_design_approval")
}
