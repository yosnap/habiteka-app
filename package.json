{
  "name": "habiteka-app",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run docs:build && next dev -p 3040",
    "build": "npm run docs:build && next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "docs:dev": "npm --prefix docs/site run dev",
    "docs:check": "npm --prefix docs/site run check",
    "docs:build": "npm --prefix docs/site run build && node scripts/copy-docs-output.mjs",
    "docs:updates": "node scripts/check-docs-updates.mjs",
    "docs:preview": "npm --prefix docs/site run preview",
    "test": "bun run scripts/test-isolated.ts run",
    "test:ci": "bun run scripts/test-isolated.ts run",
    "test:watch": "bun run scripts/test-isolated.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:dev-seed": "bun run prisma/dev-seed.ts",
    "spike:calidad": "RUN_SPIKE=true vitest run tests/spikes",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@polar-sh/sdk": "1.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "konva": "10.9.0",
    "lucide-react": "1.61.0",
    "mediabunny": "^1.62.1",
    "next": "16.4.3",
    "openai": "7.43.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "polygon-clipping": "0.15.7",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "standardwebhooks": "1.1.1",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "1.4.0",
    "use-image": "1.1.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "culori": "4.0.2",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.6",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
