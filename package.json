{
  "name": "habiteka-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1073.0",
    "@aws-sdk/s3-request-presigner": "3.1073.0",
    "@polar-sh/sdk": "0.48.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "konva": "10.3.0",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "openai": "6.44.0",
    "pg": "8.13.1",
    "radix-ui": "1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "19.2.5",
    "sharp": "0.35.2",
    "standardwebhooks": "1.0.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "use-image": "1.1.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/culori": "^4.0.1",
    "@types/node": "22.15.3",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "culori": "4.0.2",
    "dotenv": "16.4.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
