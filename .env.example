# Habiteka — variables de entorno (NOMBRES, sin valores reales)
# Copia a `.env.local` (dev) y rellena. NUNCA commitees `.env*` (ver .gitignore).

# --- Base de datos ---
DATABASE_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Acceso de desarrollo sin OAuth (SOLO local; nunca 'true' en producción):
ENABLE_DEV_LOGIN=false

# --- OAuth social ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- CAPTCHA (Cloudflare Turnstile) ---
# Server-only:
TURNSTILE_SECRET_KEY=
# Público (expuesto al cliente):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email enchufable (OTP + verificación) ---
# EMAIL_PROVIDER=resend  (por defecto) | smtp
EMAIL_PROVIDER=
# Remitente de los emails (OTP/verificación):
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Licencia (control fair-code; firma del token de licencia, server-only) ---
# Clave privada/pública EdDSA en formato PKCS8/SPKI y el id de clave (kid):
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNING_KID=

# --- Privacidad / RGPD ---
# Allowlist de modelos de IA con garantías de transferencia (SCCs/UE/zero-retention),
# separados por comas. El routing solo usa modelos de esta lista para datos personales:
AI_MODEL_JURISDICTION_ALLOWLIST=
# Ruta a los modelos de detección de caras (@vladmandic/human) para difuminado PII.
# Opcional: si no se instala el detector, se aplica strip de EXIF sin blur:
PII_FACE_MODELS_PATH=

# --- IA: chat/visión (OpenRouter vía OpenAI SDK) ---
OPENROUTER_API_KEY=
# Gateway secundario (failover si OpenRouter cae); opcional:
OPENROUTER_FALLBACK_BASE_URL=

# --- IA: imagen / render 3D (proveedor conmutable por SPIKE) ---
# IMAGE_PROVIDER=flux | nano-banana | imagen
IMAGE_PROVIDER=
IMAGE_PROVIDER_KEY=

# --- Spike de calidad IA (F-S0; SOLO ejecución manual con dev-keys) ---
# Activa el arnés de llamadas reales (sin esto, los tests del spike se omiten):
RUN_SPIKE=false
# Modelo multimodal para la detección de visión sobre boceto:
SPIKE_VISION_MODEL=

# --- Pagos (Polar.sh) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# Entorno de Polar: 'sandbox' (pruebas) o 'production'
POLAR_SERVER=sandbox
# URL de retorno tras un checkout completado:
BILLING_SUCCESS_URL=
# Id del producto "paquete de créditos" en el dashboard de Polar:
POLAR_CREDITS_PRODUCT_ID=
# Créditos que otorga ese paquete al pagarse:
POLAR_CREDITS_PER_PACK=500

# --- Storage (MinIO / S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
